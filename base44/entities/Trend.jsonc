{
  "name": "Trend",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "emerging",
        "quiet"
      ],
      "default": "active"
    },
    "momentum": {
      "type": "string",
      "enum": [
        "surging",
        "rising",
        "steady",
        "cooling"
      ],
      "default": "steady"
    },
    "momentum_basis": {
      "type": "string"
    },
    "claim_type": {
      "type": "boolean",
      "default": false
    },
    "verification": {
      "type": "string",
      "enum": [
        "unverified",
        "reported",
        "confirmed"
      ],
      "default": "unverified"
    },
    "verification_note": {
      "type": "string"
    },
    "provenance_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "item_count": {
      "type": "number",
      "default": 0
    },
    "recent_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug"
  ]
}