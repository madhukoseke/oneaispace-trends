{
  "name": "ModelProofRun",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "authorization_id": {
      "type": "string"
    },
    "claim_state": {
      "type": "string",
      "default": "open"
    },
    "claim_token": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string"
    },
    "authorized_by": {
      "type": "string"
    },
    "execution_flag": {
      "type": "boolean",
      "default": false
    },
    "kill_switch_state": {
      "type": "string"
    },
    "call_budget_per_provider": {
      "type": "number",
      "default": 1
    },
    "call_budget_total": {
      "type": "number",
      "default": 2
    },
    "call_slot_a": {
      "type": "string",
      "default": "free"
    },
    "call_slot_b": {
      "type": "string",
      "default": "free"
    },
    "slot_a_reserved_at": {
      "type": "string"
    },
    "slot_b_reserved_at": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "live",
        "contract",
        "review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "success",
        "partial",
        "failed",
        "blocked",
        "duplicate"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "operator_id": {
      "type": "string"
    },
    "operator_role": {
      "type": "string"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_model_available": {
      "type": "boolean",
      "default": false
    },
    "resolved_model_note": {
      "type": "string"
    },
    "model_calls": {
      "type": "number",
      "default": 0
    },
    "calls_per_provider": {
      "type": "object"
    },
    "input_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_record_count": {
      "type": "number",
      "default": 0
    },
    "input_chars": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number"
    },
    "usage_available": {
      "type": "boolean",
      "default": false
    },
    "usage": {
      "type": "object"
    },
    "cost_known": {
      "type": "boolean",
      "default": false
    },
    "cost": {
      "type": "object"
    },
    "cost_estimate_basis": {
      "type": "string"
    },
    "estimated_spend_usd": {
      "type": "number"
    },
    "spend_ceiling_usd": {
      "type": "number"
    },
    "error_category": {
      "type": "string"
    },
    "error_summary": {
      "type": "string"
    },
    "success_criteria": {
      "type": "object"
    },
    "success_criteria_failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "object"
    },
    "retention_days": {
      "type": "number",
      "default": 30
    },
    "retention_note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "action"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}